# Copy to .env and adjust. Never put secrets in this file: they live in SECRETS_DIR
# (generated by scripts/init-secrets.sh).
#
# This VM runs Nginx + the browser containers. Public TLS is the site's Apache reverse proxy and
# login is the site's Authelia (docs/apache-authelia.md).

# --- Names ---
# Public name of the service (an Apache vhost forwards it here).
PUBLIC_HOST=browser.example.com
# Public port, if Apache serves it on another port than 443.
#PUBLIC_PORT=443
# Your Authelia portal (logout link).
AUTHELIA_HOST=auth.example.com

TZ=Europe/Warsaw

# --- Reverse proxy -> this VM ---
# Nginx is published on BIND_ADDRESS:HTTPS_PORT, HTTPS with the certificate in TLS_DIR, which Apache
# pins. Only TRUSTED_PROXY may connect (the Apache server's address, single address or CIDR); its
# X-Forwarded-For gives the client address.
BIND_ADDRESS=0.0.0.0
HTTPS_PORT=8443
TRUSTED_PROXY=192.168.10.2/32

# --- Authelia (existing) ---
# Authz endpoint for this service, reached directly over the LAN (not through the public vhost).
# Prefer https: whoever answers this request decides who the user is.
AUTHELIA_AUTHZ_URL=https://authelia.example.internal:9091/api/authz/remote-browser
# CA for an https AUTHELIA_AUTHZ_URL. Default: the public CAs. Private CA: put its certificate in
# AUTHELIA_CA_DIR and point at it, e.g. /etc/nginx/authelia-ca/ca.crt.
#AUTHELIA_CA_FILE=/etc/ssl/certs/ca-certificates.crt

# --- FreeIPA (provisioning, scripts/validate-freeipa.py; Phase 3 sync) ---
FREEIPA_LDAP_URL=ldaps://ipa.example.internal
FREEIPA_BASE_DN=dc=example,dc=internal
# LDAP system account (cn=sysaccounts), not a regular user — see docs/freeipa.md.
FREEIPA_BIND_DN=uid=svc_remote_browser,cn=sysaccounts,cn=etc,dc=example,dc=internal
FREEIPA_BROWSER_GROUP=remote-browser-users

# --- Browser containers (Phase 2) ---
# Image built by scripts/build-browser-image.sh (it prints the tag). Pin it; never a floating tag.
BROWSER_IMAGE=local/remote-dual-browser:YYYYMMDD-chromeX-firefoxY
# Address pool of the per-user browser networks; scripts/egress-firewall.sh filters traffic from it.
# Must not overlap your LAN or other Docker networks.
BROWSER_NET_POOL=10.213.0.0/16
# Selkies file transfer between the user's device and /config: "", "upload", "download" or
# "upload,download". Off by default (plan §43).
BROWSER_FILE_TRANSFERS=

# Phase 2 only (compose.browser-test.yaml): the one test user, with their FreeIPA numbers
# (ipa user-show <uid> --raw | grep -E 'uidnumber|gidnumber'). Phase 3 generates all users.
BROWSER_TEST_USER=remote-browser-test
BROWSER_TEST_UID=
BROWSER_TEST_GID=
# A /28 inside BROWSER_NET_POOL.
BROWSER_TEST_SUBNET=10.213.0.16/28
# Saves the -f options on every docker compose command.
COMPOSE_FILE=compose.yaml:compose.browser-test.yaml

# --- Host paths ---
# Relative paths are relative to this directory. Defaults keep everything in ./local (git-ignored).
SECRETS_DIR=./local/secrets
TLS_DIR=./local/tls
FREEIPA_CA_DIR=./local/freeipa-ca
AUTHELIA_CA_DIR=./local/authelia-ca
USER_DATA_ROOT=./local/users
NGINX_GENERATED_DIR=./nginx/generated
