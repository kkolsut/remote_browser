# Egress filter for the browser containers (scripts/egress-firewall.sh, plan §30a): an nftables table
# of its own. Applied at boot before Nginx and any browser starts; every browser unit Requires= it,
# so no browser runs without it. Installed by scripts/install-units.py.
#
# Restarting a service that flushes the whole ruleset (nftables.service) removes the table:
# restart this unit afterwards. PartOf makes that automatic for nftables.service.
[Unit]
Description=Remote browser: block browser containers from LAN, host and each other
After=nftables.service firewalld.service network-pre.target
Before=rb-nginx.service
PartOf=nftables.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=@REPO_DIR@/scripts/egress-firewall.sh apply
ExecStop=@REPO_DIR@/scripts/egress-firewall.sh remove

[Install]
WantedBy=multi-user.target
