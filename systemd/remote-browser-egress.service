# Egress filter for the browser containers (scripts/egress-firewall.sh, plan §30a): an nftables table
# of its own, for Docker and Podman alike. Applied at boot before any container starts. Install
# (replace the path with your root-owned checkout):
#   sed 's|@REPO_DIR@|/opt/remote-browser|' systemd/remote-browser-egress.service \
#       | sudo tee /etc/systemd/system/remote-browser-egress.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now remote-browser-egress.service
#
# Restarting a service that flushes the whole ruleset (Debian's nftables.service) removes the table:
# restart this unit afterwards. PartOf makes that automatic for nftables.service.
[Unit]
Description=Remote browser: block browser containers from LAN, host and each other
After=nftables.service firewalld.service network-pre.target
Before=docker.service podman.service podman-restart.service
PartOf=nftables.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=@REPO_DIR@/scripts/egress-firewall.sh apply
ExecStop=@REPO_DIR@/scripts/egress-firewall.sh remove

[Install]
WantedBy=multi-user.target
