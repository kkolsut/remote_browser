# Nightly file-level backup (scripts/backup.sh, plan §46) into BACKUP_DIR; keeps BACKUP_KEEP backups.
# Each user's browser is paused while their profile is archived (an open stream freezes, it does not
# end), hence at night. Copy BACKUP_DIR off the VM; Proxmox Backup Server snapshots come first.
# Installed by scripts/install-units.py (@REPO_DIR@ becomes the root-owned checkout).
[Unit]
Description=Remote browser: back up configuration, secrets and profiles

[Service]
Type=oneshot
WorkingDirectory=@REPO_DIR@
ExecStart=@REPO_DIR@/scripts/backup.sh
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle
