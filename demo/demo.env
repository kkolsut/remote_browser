# Environment for the local demo (scripts/demo.sh): dummy users, no FreeIPA, loopback only,
# self-signed TLS. *.localhost resolves to 127.0.0.1 in browsers and curl.
PUBLIC_HOST=browser.localhost
AUTHELIA_HOST=auth.browser.localhost
TZ=UTC

# The demo Apache (the "existing reverse proxy") listens on PUBLIC_PORT; the browser VM's Nginx is
# published on HTTPS_PORT but only answers the Apache container (TRUSTED_PROXY, compose.demo.yaml).
BIND_ADDRESS=127.0.0.1
PUBLIC_PORT=8443
HTTPS_PORT=8444
TRUSTED_PROXY=10.214.0.10/32
AUTHELIA_AUTHZ_URL=http://authelia:9091/api/authz/remote-browser

# Demo Authelia (compose.demo.yaml), file backend.
AUTH_BACKEND=file
FREEIPA_BROWSER_GROUP=remote-browser-users

SECRETS_DIR=./local/demo/secrets
TLS_DIR=./local/demo/tls
FREEIPA_CA_DIR=./local/demo/freeipa-ca
AUTHELIA_CA_DIR=./local/demo/authelia-ca
AUTHELIA_DATA_DIR=./local/demo/authelia
USER_DATA_ROOT=./local/demo/users
NGINX_GENERATED_DIR=./local/demo/nginx-generated

# --- Phase 2: alice's dual-browser container (compose.browser-test.yaml) ---
# demo.sh builds this image on first use and runs the container with YOUR uid/gid
# (BROWSER_TEST_UID/GID), so you can delete local/demo without root.
BROWSER_IMAGE=local/remote-dual-browser:demo
BROWSER_TEST_USER=alice
BROWSER_NET_POOL=10.213.0.0/16
BROWSER_TEST_SUBNET=10.213.255.16/28
